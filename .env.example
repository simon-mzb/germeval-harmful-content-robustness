# Copy to `.env` and fill in both values. `.env` is gitignored; never commit it.
#
# Only the LLM judge of the combination layer (E3) and the endpoint smoke test
# (`python -m src.gwdg_smoke`) need these. They point at the GWDG ChatAI / SAIA
# service, which is OpenAI-compatible. No key is included in this repository.
OPENAI_API_KEY=
OPENAI_BASE_URL=
